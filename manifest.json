{
  "manifest_version": 3,
  "name": "Minerr",
  "version": "0.1.0",
  "description": "Colors Japanese words by status, shows dictionary definitions on hover, and adds Anki cards.",
  "permissions": ["storage", "offscreen", "unlimitedStorage"],
  "optional_permissions": ["clipboardRead"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8765/*", "http://127.0.0.1:8766/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"] }
  ],
  "web_accessible_resources": [
    { "resources": ["src/anki.js", "src/anywhere.js", "src/autopause.js", "src/captions.js", "src/cardform.js", "src/chord.js", "src/dom.js", "src/furigana.js", "src/group.js", "src/hover.js", "src/iplusone.js", "src/keys.js", "src/lapis.js", "src/linelist.js", "src/meta.js", "src/overlay.js", "src/page.js", "src/parse.js", "src/pitch-colors.js", "src/playback.js", "src/popup-view.js", "src/popup.js", "src/record.js", "src/rpc.js", "src/score.js", "src/sentence-hover.js", "src/sentence-text.js", "src/sentence.js", "src/settings.js", "src/site.js", "src/stats.js", "src/status.js", "src/subtitles.js", "src/tags.js", "src/theme.js", "src/video.js", "src/videokeys.js", "src/videosettings.js", "src/whisper.js", "src/words.js"], "matches": ["<all_urls>"] }
  ],
  "action": { "default_title": "Minerr", "default_popup": "action.html" },
  "commands": {
    "toggle-minerr": { "suggested_key": { "default": "Alt+Shift+M" }, "description": "Turn Minerr on or off in all tabs" }
  },
  "options_page": "options.html"
}
