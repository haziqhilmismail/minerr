{
  "manifest_version": 3,
  "name": "Minerr",
  "version": "0.3.0",
  "description": "Colors Japanese words by status, shows dictionary definitions on hover, and adds Anki cards.",
  "permissions": ["storage", "offscreen", "unlimitedStorage", "nativeMessaging", "sidePanel"],
  "optional_permissions": ["clipboardRead"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8765/*", "http://127.0.0.1:8766/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"] },
    { "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["src/video/youtube/youtube-main.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://www.netflix.com/*"], "js": ["src/video/netflix/netflix-main.js"], "run_at": "document_start", "world": "MAIN" }
  ],
  "web_accessible_resources": [
    { "resources": ["src/*.js"], "matches": ["<all_urls>"] }
  ],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Minerr", "default_popup": "pages/action.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "commands": {
    "toggle-minerr": { "suggested_key": { "default": "Alt+Shift+M" }, "description": "Turn Minerr on or off in all tabs" },
    "lookup-selection": { "suggested_key": { "default": "Alt+S" }, "description": "Look up the selected text" },
    "word-join": { "suggested_key": { "default": "Alt+J" }, "description": "Make the selected text one word, or remove that word override" },
    "toggle-site": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Turn the page text of this site on or off" },
    "toggle-sentence-highlight": { "description": "Turn the sentence highlight on or off. Alt+Shift+S on a page also does this." }
  },
  "options_page": "pages/options.html"
}
